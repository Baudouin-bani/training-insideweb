<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
<!-- Désactiver la page d’accueil par défaut -->
<record id="website.homepage" model="ir.ui.view">
    <field name="active" eval="False" />
</record>

    <record id="page_home" model="website.page">
        <field name="name">Home</field>
        <field name="is_published" eval="True" />
        <field name="key">website_monprojet.page_home</field>
        <field name="url">/</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="website_monprojet.page_home">
                <t t-call="website.layout">
                    <!-- Title -->
                    <t t-set="additional_title">Titre de ma page</t>
                    <t t-set="pageName" t-valuef="x_wd_mapage" />
                    <t t-set="meta_description">Description de ma page</t>
                    <t t-set="no_header" t-value="False" />
                    <t t-set="no_footer" t-value="True" />
                    <!-- Content -->
                    <div id="wrap" class="oe_structure">
                       <img src="/web/image/website_airproof.img_icon" alt="" />

                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
